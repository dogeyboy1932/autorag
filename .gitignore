node_modules/
.next/
out/
# Every env file, then the documented examples back. `.env` and `.env*.local`
# were the old patterns and they missed `.env2` — an allowlist is the right shape
# here, because the cost of forgetting is a service key in a public repo and the
# cost of an over-broad ignore is one `git add -f`.
.env*
!.env.example
!.env.local.example
!.env2.example
.vercel
*.tsbuildinfo
next-env.d.ts
.DS_Store
out/
extension/dist/

# Built by `pnpm ext:zip` during the deploy, from the dist the checks ran
# against. Committing a 20MB binary would mean re-committing it on every
# extension change, and shipping a stale one the first time someone forgot.
public/autorag-extension.zip

# Working notes kept at the root — build plan, manual, handoff, amendments.
# They were written for whoever is building this, not for whoever reads the
# repo, and they stay on disk for that person. README and LICENSE are what a
# reader needs.
archive/
